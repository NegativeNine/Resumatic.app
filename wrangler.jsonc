{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resumatic",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The Vite plugin supplies the assets directory at build time.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/admin/*",
      "/billing/*",
      "/mcp",
      "/oauth/*",
      "/.well-known/*",
      "/share/*",
    ],
  },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "VAULT", "class_name": "Vault" },
    ],
  },
  // Declarative Durable Object lifecycle; replaces the legacy migrations array.
  // Environments inherit this block.
  "exports": {
    "Directory": { "type": "durable-object", "storage": "sqlite" },
    "Vault": { "type": "durable-object", "storage": "sqlite" },
    "PilotBudget": { "type": "durable-object", "storage": "sqlite" },
  },
  "workflows": [
    {
      "name": "distill",
      "binding": "DISTILL",
      "class_name": "DistillWorkflow",
    },
    { "name": "tailor", "binding": "TAILOR", "class_name": "TailorWorkflow" },
    {
      "name": "documents",
      "binding": "DOCUMENTS",
      "class_name": "DocumentWorkflow",
    },
    {
      "name": "reembed",
      "binding": "REEMBED",
      "class_name": "ReembedWorkflow",
    },
    {
      "name": "fleet-reembed",
      "binding": "FLEET_REEMBED",
      "class_name": "FleetReembedWorkflow",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "resumatic-files" }],
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "resumatic_steps" },
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 },
    },
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "ai": { "binding": "AI", "remote": true },
  "browser": { "binding": "BROWSER" },
  // Secrets (wrangler secret put): SESSION_KEY, OIDC_CLIENT_SECRET, CF_AI_TOKEN. See src/env.d.ts.
  "vars": {
    // Where the Directory is pinned on its first request. Final choice is made at launch.
    "DIRECTORY_HINT": "enam",
    // Delay before the second R2 sweep after an account deletion.
    "SWEEP_DELAY_MS": "3600000",
    // Invite list gates sign-up until launch. "false" opens sign-up.
    "INVITE_ONLY": "true",
    "TAILOR_MONTHLY_LIMIT": "20",
    // Google OAuth client (the secret is OIDC_CLIENT_SECRET).
    "OIDC_CLIENT_ID": "",
    // Chat models go through AI Gateway's unified endpoint on this account.
    "CF_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": "resumatic",
    "METRICS_DATASET": "resumatic_steps",
    "MCP_ENABLED": "false",
    "BILLING_ENABLED": "false",
    "ALERTS_ENABLED": "false",
    "DAILY_SPEND_CAP_USD": "0",
    "MODEL_EXTRACT": "anthropic/claude-haiku-5.5",
    "MODEL_ANALYZE": "anthropic/claude-haiku-5.5",
    "MODEL_WRITE": "anthropic/claude-sonnet-5.5",
    // A different model family, so the checker does not share the writer's blind spots.
    "MODEL_JUDGE": "openai/gpt-5",
    // Cloudflare Access application protecting /admin/*.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
  },
  "observability": { "logs": { "enabled": true } },
  "env": {
    // Build with CLOUDFLARE_ENV=staging, then run wrangler deploy. Deploys as the Worker "resumatic-staging".
    // Bindings, Workflows and vars are not inherited, so they are repeated with staging names.
    "staging": {
      "version_metadata": { "binding": "PILOT_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [
          { "name": "DIRECTORY", "class_name": "Directory" },
          { "name": "VAULT", "class_name": "Vault" },
          { "name": "PILOT_BUDGET", "class_name": "PilotBudget" },
        ],
      },
      "workflows": [
        {
          "name": "distill-staging",
          "binding": "DISTILL",
          "class_name": "DistillWorkflow",
        },
        {
          "name": "tailor-staging",
          "binding": "TAILOR",
          "class_name": "TailorWorkflow",
        },
        {
          "name": "documents-staging",
          "binding": "DOCUMENTS",
          "class_name": "DocumentWorkflow",
        },
        {
          "name": "reembed-staging",
          "binding": "REEMBED",
          "class_name": "ReembedWorkflow",
        },
        {
          "name": "fleet-reembed-staging",
          "binding": "FLEET_REEMBED",
          "class_name": "FleetReembedWorkflow",
        },
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "resumatic-files-staging" },
      ],
      "analytics_engine_datasets": [
        { "binding": "METRICS", "dataset": "resumatic_steps_staging" },
      ],
      "ratelimits": [
        {
          "name": "AUTH_LIMIT",
          "namespace_id": "1101",
          "simple": { "limit": 100, "period": 60 },
        },
        {
          "name": "WRITE_LIMIT",
          "namespace_id": "1102",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "triggers": { "crons": ["*/15 * * * *"] },
      "ai": { "binding": "AI", "remote": true },
      "browser": { "binding": "BROWSER" },
      // Staging also sets the TEST_SIGNIN_KEY secret, which enables POST /auth/test-login.
      "vars": {
        "DIRECTORY_HINT": "enam",
        "SWEEP_DELAY_MS": "60000",
        "INVITE_ONLY": "true",
        "ALLOW_TEST_SIGNIN": "true",
        "TAILOR_MONTHLY_LIMIT": "50",
        "OIDC_CLIENT_ID": "",
        "CF_ACCOUNT_ID": "",
        "AI_GATEWAY_ID": "resumatic-staging",
        "METRICS_DATASET": "resumatic_steps_staging",
        "MCP_ENABLED": "false",
        "BILLING_ENABLED": "false",
        "ALERTS_ENABLED": "false",
        "DAILY_SPEND_CAP_USD": "0",
        "MODEL_EXTRACT": "meta/muse-ember-1.0",
        "MODEL_ANALYZE": "meta/muse-ember-1.0",
        "MODEL_WRITE": "meta/muse-ember-1.0",
        "MODEL_JUDGE": "@cf/cloudflare/clef",
        // Desired rebuild target; each vault retains its active model until activation.
        "EMBEDDING_MODEL": "@cf/qwen/qwen3-embedding-0.6b",
        "RERANK_MODEL": "@cf/cloudflare/clef",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
      },
    },
  },
}
