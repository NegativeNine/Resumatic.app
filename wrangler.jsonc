{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resumatic",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Vite plugin supplies the assets directory at build time.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/admin/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "VAULT", "class_name": "Vault" }
    ]
  },
  // Declarative Durable Object lifecycle; replaces the legacy migrations array.
  // Environments inherit this block.
  "exports": {
    "Directory": { "type": "durable-object", "storage": "sqlite" },
    "Vault": { "type": "durable-object", "storage": "sqlite" }
  },
  "workflows": [
    { "name": "distill", "binding": "DISTILL", "class_name": "DistillWorkflow" },
    { "name": "tailor", "binding": "TAILOR", "class_name": "TailorWorkflow" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "resumatic-files" }],
  "ai": { "binding": "AI", "remote": true },
  "browser": { "binding": "BROWSER" },
  // Secrets (wrangler secret put): SESSION_KEY, OIDC_CLIENT_SECRET, CF_AI_TOKEN. See src/env.d.ts.
  "vars": {
    // Where the Directory is pinned on its first request. Final choice is made at launch.
    "DIRECTORY_HINT": "enam",
    // Delay before the second R2 sweep after an account deletion.
    "SWEEP_DELAY_MS": "3600000",
    // Invite list gates sign-up until launch. "false" opens sign-up.
    "INVITE_ONLY": "true",
    "TAILOR_MONTHLY_LIMIT": "20",
    // Google OAuth client (the secret is OIDC_CLIENT_SECRET).
    "OIDC_CLIENT_ID": "",
    // Chat models go through AI Gateway's unified endpoint on this account.
    "CF_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": "resumatic",
    "MODEL_EXTRACT": "anthropic/claude-haiku-5-5",
    "MODEL_ANALYZE": "anthropic/claude-haiku-5-5",
    "MODEL_WRITE": "anthropic/claude-sonnet-5-5",
    // A different model family, so the checker does not share the writer's blind spots.
    "MODEL_JUDGE": "openai/gpt-5",
    // Cloudflare Access application protecting /admin/*.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "logs": { "enabled": true } },
  "env": {
    // Build with CLOUDFLARE_ENV=staging, then run wrangler deploy. Deploys as the Worker "resumatic-staging".
    // Bindings, Workflows and vars are not inherited, so they are repeated with staging names.
    "staging": {
      "durable_objects": {
        "bindings": [
          { "name": "DIRECTORY", "class_name": "Directory" },
          { "name": "VAULT", "class_name": "Vault" }
        ]
      },
      "workflows": [
        { "name": "distill-staging", "binding": "DISTILL", "class_name": "DistillWorkflow" },
        { "name": "tailor-staging", "binding": "TAILOR", "class_name": "TailorWorkflow" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "resumatic-files-staging" }],
      "ai": { "binding": "AI", "remote": true },
      "browser": { "binding": "BROWSER" },
      // Staging also sets the TEST_SIGNIN_KEY secret, which enables POST /auth/test-login.
      "vars": {
        "DIRECTORY_HINT": "enam",
        "SWEEP_DELAY_MS": "60000",
        "INVITE_ONLY": "true",
        "TAILOR_MONTHLY_LIMIT": "50",
        "OIDC_CLIENT_ID": "",
        "CF_ACCOUNT_ID": "",
        "AI_GATEWAY_ID": "resumatic-staging",
        "MODEL_EXTRACT": "anthropic/claude-haiku-5-5",
        "MODEL_ANALYZE": "anthropic/claude-haiku-5-5",
        "MODEL_WRITE": "anthropic/claude-sonnet-5-5",
        "MODEL_JUDGE": "openai/gpt-5",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      }
    }
  }
}
