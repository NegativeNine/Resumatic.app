{
  "name": "resumatic",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types --strict-vars=false",
    "dev": "vite dev",
    "dev:remote": "REMOTE_BINDINGS=1 vite dev",
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false && tsc -b",
    "test": "vitest run --project unit --project integration",
    "test:watch": "vitest --project unit --project integration",
    "evals": "vitest run --project evals",
    "e2e:staging": "node scripts/e2e-staging.mjs",
    "eval:extract": "node test/extract-evals/cli.mjs",
    "check:config": "node scripts/validate-config.mjs",
    "build:production": "vite build",
    "eval:seeded": "node scripts/seeded-evals.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "models:record": "node scripts/record-models.mjs",
    "check:release": "node scripts/check-release.mjs",
    "audit:deletion": "node scripts/audit-deletion.mjs",
    "check:ats": "node scripts/ats-smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.33.0",
    "fflate": "0.8.3",
    "hono": "^4.13.16",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  }
}
