{
  "name": "resumatic",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types",
    "dev": "vite dev",
    "dev:remote": "REMOTE_BINDINGS=1 vite dev",
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  }
}
