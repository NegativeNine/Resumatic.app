{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src/env.d.ts",
    "src/worker",
    "src/directory",
    "src/vault",
    "src/workflows",
    "src/pipeline",
    "src/grounding",
    "src/ai",
    "src/render",
    "src/shared",
    "src/taxonomy"
  ]
}
